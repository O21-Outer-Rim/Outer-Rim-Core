<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<PipeSystem.PipeNetDef>
		<defName>OuterRim_BactaNetwork</defName>
		<label>bacta pipe network</label>
		<resource>
			<name>Bacta</name>
			<unit>l</unit>
			<color>(126, 186, 230)</color>
			<onlyShowStored>true</onlyShowStored>
		</resource>
		<pipeDefs>
			<li>OuterRim_BactaPipe</li>
		</pipeDefs>
		<designator>
			<deconstructIconPath>OuterRim/Building/BactaPipeDeconstruct_MenuIcon</deconstructIconPath>
			<designationCategoryDef>OuterRim_ArchitectHypertech</designationCategoryDef>
		</designator>
		<overlayOptions>
			<overlayColor>(126, 186, 230)</overlayColor>
		</overlayOptions>
	</PipeSystem.PipeNetDef>

	<ThingDef ParentName="OuterRimBuildingBase">
		<defName>OuterRim_BactaPipe</defName>
		<label>bacta pipe</label>
		<description>Can be placed under walls and other buildings.</description>
		<thingClass>PipeSystem.Building_Pipe</thingClass>
		<category>Building</category>
		<graphicData>
			<texPath>OuterRim/Building/BactaPipe_Atlas</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<linkType>Basic</linkType>
			<linkFlags>
				<li>Custom10</li>
			</linkFlags>
			<damageData>
				<rect>(0,0.35,1,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>OuterRim/Building/BactaPipe_MenuIcon</uiIconPath>
		<building>
			<ai_chillDestination>false</ai_chillDestination>
			<isInert>true</isInert>
			<isEdifice>false</isEdifice>
		</building>
		<drawerType>MapMeshOnly</drawerType>
		<altitudeLayer>Conduits</altitudeLayer>
		<passability>Standable</passability>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>35</WorkToBuild>
		</statBases>
		<drawStyleCategory>Conduits</drawStyleCategory>
		<costList>
			<OuterRim_Durasteel>1</OuterRim_Durasteel>
		</costList>
		<comps>
			<li Class="PipeSystem.CompProperties_Resource">
				<pipeNet>OuterRim_BactaNetwork</pipeNet>
			</li>
		</comps>
		<placeWorkers>
			<li>PipeSystem.PlaceWorker_Pipe</li>
		</placeWorkers>
		<rotatable>false</rotatable>
		<selectable>true</selectable>
		<neverMultiSelect>true</neverMultiSelect>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<designationCategory>OuterRim_ArchitectHypertech</designationCategory>
		<constructEffect>ConstructMetal</constructEffect>
		<clearBuildingArea>false</clearBuildingArea>
		<researchPrerequisites>
			<li>OuterRim_HealingHypertech</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Resources</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>OuterRim_BactaBottler</defName>
		<label>bacta bottler</label>
		<description>A bacta bottler. Used to extract bacta cannisters from the network.</description>
		<thingClass>Building_Storage</thingClass>
		<graphicData>
			<texPath>OuterRim/Building/BactaBottler</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
		</graphicData>
		<rotatable>false</rotatable>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.5</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<pathCost>50</pathCost>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>8</Mass>
			<WorkToBuild>600</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>0.5</Beauty>
		</statBases>
		<size>(1,1)</size>
		<costList>
			<Steel>10</Steel>
		</costList>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<thingDefs>
						<li>OuterRim_Bacta</li>
					</thingDefs>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Important</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<thingDefs>
						<li>OuterRim_Bacta</li>
					</thingDefs>
				</filter>
			</defaultStorageSettings>
		</building>
		<inspectorTabs>
			<li>ITab_Storage</li>
		</inspectorTabs>
		<designationCategory>OuterRim_ArchitectHypertech</designationCategory>
		<staticSunShadowHeight>0.5</staticSunShadowHeight>
		<surfaceType>Item</surfaceType>
		<canOverlapZones>false</canOverlapZones>
		<comps>
			<li Class="PipeSystem.CompProperties_ConvertResourceToThing">
				<pipeNet>OuterRim_BactaNetwork</pipeNet>
				<thing>OuterRim_Bacta</thing>
			</li>
		</comps>
		<researchPrerequisites>
			<li>OuterRim_HealingHypertech</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Resources</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>OuterRim_BactaSiphon</defName>
		<label>bacta siphon</label>
		<description>A bacta siphon. Used to insert bacta cannisters into the network.</description>
		<thingClass>Building_Storage</thingClass>
		<graphicData>
			<texPath>OuterRim/Building/BactaSiphon</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
			<drawRotated>false</drawRotated>
			<allowFlip>false</allowFlip>
		</graphicData>
		<rotatable>false</rotatable>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.5</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<pathCost>50</pathCost>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>8</Mass>
			<WorkToBuild>600</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>0.5</Beauty>
		</statBases>
		<size>(1,1)</size>
		<costList>
			<Steel>10</Steel>
		</costList>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<thingDefs>
						<li>OuterRim_Bacta</li>
					</thingDefs>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Important</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<thingDefs>
						<li>OuterRim_Bacta</li>
					</thingDefs>
				</filter>
			</defaultStorageSettings>
		</building>
		<inspectorTabs>
			<li>ITab_Storage</li>
		</inspectorTabs>
		<designationCategory>OuterRim_ArchitectHypertech</designationCategory>
		<staticSunShadowHeight>0.5</staticSunShadowHeight>
		<surfaceType>Item</surfaceType>
		<canOverlapZones>false</canOverlapZones>
		<tickerType>Rare</tickerType>
		<comps>
			<li Class="PipeSystem.CompProperties_ConvertThingToResource">
				<pipeNet>OuterRim_BactaNetwork</pipeNet>
				<thing>OuterRim_Bacta</thing>
			</li>
		</comps>
		<researchPrerequisites>
			<li>OuterRim_HealingHypertech</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="TabulaRasa.DefModExt_SubcategoryDisplay">
				<subcategories>
					<li>Resources</li>
				</subcategories>
			</li>
		</modExtensions>
	</ThingDef>

</Defs>